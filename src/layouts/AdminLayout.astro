---
import "@styles/global.css";

interface Props {
  title?: string;
}

const { title = "XBSTACK Publisher" } = Astro.props as Props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="XBSTACK Publisher is a Markdown-first publishing workspace for creators." />
    <title>{title} - XBSTACK Publisher</title>
  </head>
  <body class="bg-slate-950 text-slate-200 antialiased">
    <div class="min-h-screen grid grid-cols-1 lg:grid-cols-[260px_1fr]">
      <aside class="lg:sticky lg:top-0 lg:h-screen bg-slate-900 border-r border-white/10 p-6">
        <a href="/" class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-orange-600 grid place-items-center text-white font-black italic">XP</div>
          <div>
            <div class="text-white font-black tracking-tight uppercase">XBSTACK</div>
            <div class="text-[10px] text-slate-500 font-black uppercase tracking-widest">Publisher</div>
          </div>
        </a>

        <nav class="space-y-2">
          <a href="/admin/publisher/" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-orange-600 text-white text-xs font-black uppercase tracking-widest">
            <span>Publish</span>
          </a>
          <a href="https://github.com/xbstack/xbstack-publisher" target="_blank" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-black uppercase tracking-widest">
            <span>GitHub</span>
          </a>
        </nav>

        <div class="mt-10 p-4 rounded-2xl bg-black/30 border border-white/10">
          <div class="text-[10px] text-slate-500 font-black uppercase tracking-widest">Version</div>
          <div class="mt-1 text-sm text-white font-black">v0.1.0-alpha</div>
        </div>
      </aside>

      <main class="min-w-0">
        <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl px-6 md:px-10 py-5">
          <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
              <div class="text-[10px] text-sky-400 font-black uppercase tracking-widest">Markdown-first multi-platform publishing</div>
              <h1 class="mt-2 text-3xl md:text-5xl text-white font-black italic uppercase tracking-tight">{title}</h1>
            </div>
            <div class="text-xs text-slate-500 max-w-md">
              Publish WeChat Official Account drafts through Wenyan Server and generate copy-ready exports for other platforms.
            </div>
          </div>
        </header>

        <div class="p-6 md:p-10">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
