{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "types": ["@astrojs/client"],
    "paths": {
      "@features/*": ["src/features/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"]
    }
  },
  "include": ["src/**/*", "astro.config.mjs"],
  "exclude": ["node_modules", "dist"]
}
